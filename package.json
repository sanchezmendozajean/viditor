{
  "name": "viditor",
  "version": "0.1.0",
  "description": "Editor de video de escritorio con transiciones programables",
  "main": "./out/main/index.js",
  "author": "Viditor",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "licenses": "node scripts/generate-licenses.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build:app": "cross-env VITEPRESS_TARGET=app vitepress build docs",
    "docs:build:pages": "cross-env VITEPRESS_TARGET=pages vitepress build docs",
    "pack": "npm run ffmpeg:fetch && npm run docs:build:app && npm run build && electron-builder"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "pinia": "^4.1.0",
    "ulid": "^3.0.2",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "cross-env": "^10.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-static": "^1.68.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.21.5": true
  }
}
